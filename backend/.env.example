# PostgreSQL Connection string for pgAdmin 4:
# Format: postgresql://<username>:<password>@localhost:5432/<database_name>
# Example for your PostgreSQL 18 server in pgAdmin:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bar_management

# Fallback SQLite Database (if DATABASE_URL is commented out):
DATABASE_URL=sqlite:///./bermuda_pub.db

# Production Security Configuration (MANDATORY):
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=12

# Environment: development or production (disables /docs in production)
ENVIRONMENT=production

# Strict CORS Allowed Origins (Comma-separated, no wildcards)
ALLOWED_ORIGINS=https://elitedominators.com,https://www.elitedominators.com,https://bermuda-cocktail-frontend.onrender.com,http://localhost:3000,http://localhost:5173
