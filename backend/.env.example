# PostgreSQL Connection string for pgAdmin 4:
# Format: postgresql://<username>:<password>@localhost:5432/<database_name>
# Example for your PostgreSQL 18 server in pgAdmin:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bar_management

# Fallback SQLite Database (if DATABASE_URL is commented out):
DATABASE_URL=sqlite:///./bermuda_pub.db
